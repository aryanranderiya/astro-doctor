{
  "name": "astro-doctor",
  "version": "0.20.0",
  "description": "Deterministic static analysis for Astro \u2014 islands, data-fetching, SSR, security, and performance. No LLM, AST/regex only.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/engine.js",
    "./rules": "./src/rules/index.js"
  },
  "bin": {
    "astro-doctor": "./bin/astro-doctor.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/RULES.md",
    "skills/",
    "astro-doctor.config.example.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "doctor": "node ./bin/astro-doctor.js",
    "test": "node --test test/rules.test.js test/cli.test.js test/invariants.test.js test/properties.test.js test/parse.test.js test/docs.test.js",
    "scan:self": "node ./bin/astro-doctor.js .",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "astro",
    "linter",
    "static-analysis",
    "islands",
    "hydration",
    "performance",
    "security",
    "ssr",
    "content-collections",
    "a11y"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryanranderiya/astro-doctor.git"
  },
  "homepage": "https://github.com/aryanranderiya/astro-doctor#readme",
  "bugs": {
    "url": "https://github.com/aryanranderiya/astro-doctor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@astrojs/compiler": "^4.0.0"
  }
}
